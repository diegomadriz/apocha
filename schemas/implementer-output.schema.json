{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementer result (submit_result)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "blocked"
      ],
      "default": "done"
    },
    "blocked_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "unresolved_uncertainties": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "criteria_evidence": {
      "type": "array",
      "description": "Required when status is \"done\" or omitted; one entry per acceptance criterion (1-based). Optional when blocked.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "type": "integer",
            "minimum": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "test",
                    "check",
                    "inspection"
                  ]
                }
              },
              "required": [
                "kind"
              ],
              "if": {
                "properties": {
                  "kind": {
                    "const": "test"
                  }
                }
              },
              "then": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "test"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "name"
                ]
              },
              "else": {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "check"
                    }
                  }
                },
                "then": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "check"
                    },
                    "check_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "check_id"
                  ]
                },
                "else": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "inspection"
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "required": [
                    "kind",
                    "note"
                  ]
                }
              }
            }
          }
        },
        "required": [
          "criterion",
          "evidence"
        ]
      }
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "blocked"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "required": [
      "blocked_reason"
    ]
  },
  "else": {
    "not": {
      "required": [
        "blocked_reason"
      ]
    },
    "required": [
      "criteria_evidence"
    ]
  }
}
