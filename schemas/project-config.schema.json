{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apocha project config (apocha.config.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "checks"],
  "properties": {
    "version": { "const": 1 },
    "checks": {
      "description": "The closed check catalog. Tasks refer to these IDs only.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/check_id" },
      "additionalProperties": { "$ref": "#/$defs/check" }
    },
    "fixers": {
      "description": "Closed fixer catalog read from the base commit.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/check_id" },
      "additionalProperties": { "$ref": "#/$defs/fixer" }
    },
    "default_fixers": {
      "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/check_id" }
    },
    "check_selection": {
      "description": "Rules that pick checks from changed paths when a task or integration names none. All matching rules apply.",
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["paths", "checks"],
        "properties": {
          "paths": { "description": "Entries match directory prefixes ending in / without wildcards, exact paths, or * wildcards in basenames at any depth or only the last component under a literal directory; * never crosses /, and **, directory or prefix wildcards, ?, {, and } are unsupported. Brackets [ and ] match literally (for example Next.js route folders).", "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/path" } },
          "checks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/check_id" } }
        }
      }
    },
    "default_checks": {
      "description": "Checks that always run when checks are selected by rule.",
      "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/check_id" }
    },
    "receipts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "allowed_signers": { "$ref": "#/$defs/path", "default": ".apocha/allowed_signers" },
        "require_signed": { "type": "boolean", "default": false }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "require_independent": { "type": "boolean", "default": false }
      }
    },
    "tests": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "paths": { "description": "Entries match directory prefixes ending in / without wildcards, exact paths, or * wildcards in basenames at any depth or only the last component under a literal directory; * never crosses /, and **, directory or prefix wildcards, ?, {, and } are unsupported. Brackets [ and ] match literally (for example Next.js route folders).", "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "hook_files": { "description": "Additional test hook path patterns, using tests.paths syntax. New hooks require fixture test_changes declarations independently of judge inputs.", "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "run_files": { "$ref": "#/$defs/run_files" }
      }
    },
    "paths": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "judge_inputs": { "description": "Additional judge input patterns; built-in patterns always apply. Basenames match at any depth, case-insensitively.", "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/path" } },
        "protected": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "governance": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "forbidden": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "always_readable": { "description": "Files every agent may read without the task listing them. A name without / matches that file name in any directory. Default [\"AGENTS.md\"].", "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" }, "default": ["AGENTS.md"] },
        "design_reference_prefix": { "$ref": "#/$defs/path" }
      }
    },
    "refs": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "batch_prefix": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+/$" },
        "notes": { "type": "string", "pattern": "^refs/notes/[A-Za-z0-9._/-]+$" }
      }
    },
    "sandbox": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["auto", "required", "none"] },
        "network": { "enum": ["deny", "allow"] },
        "home_reads": { "enum": ["deny", "allow"], "default": "deny" },
        "allow_read": { "type": "array", "maxItems": 50, "default": [], "items": { "type": "string", "minLength": 1 } },
        "deny_sockets": { "description": "Additional local daemon socket paths to deny; built-in defaults always apply. ~/ is expanded.", "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "deny_read": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_repair_attempts": { "type": "integer", "minimum": 0, "maximum": 2 },
        "default_repair_attempts": { "type": "integer", "minimum": 0, "maximum": 2 },
        "review_diff_bytes": { "type": "integer", "minimum": 10000, "maximum": 2000000 },
        "run_check_calls": { "type": "integer", "minimum": 0, "maximum": 30 },
        "check_concurrency": { "type": "integer", "minimum": 1, "maximum": 8, "default": 2 },
        "check_output_bytes": { "type": "integer", "minimum": 2000, "maximum": 1000000 }
      }
    }
  },
  "$defs": {
    "check_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 400 },
    "run_files": {
      "type": "object", "additionalProperties": false, "required": ["run"],
      "properties": {
        "paths": { "description": "Entries match directory prefixes ending in / without wildcards, exact paths, or * wildcards in basenames at any depth or only the last component under a literal directory; * never crosses /, and **, directory or prefix wildcards, ?, {, and } are unsupported. Brackets [ and ] match literally (for example Next.js route folders).", "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "run": {
          "description": "argv with exactly one whole {files} element, expanded to individual test paths.",
          "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 400 },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "dependencies": { "enum": ["npm", "pnpm"] },
        "env": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 2000 } }
      }
    },
    "fixer": {
      "type": "object", "additionalProperties": false, "required": ["run"],
      "properties": {
        "description": { "type": "string", "maxLength": 300 },
        "run": {
          "description": "argv; optional whole {files} element expands to eligible paths relative to cwd.",
          "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 400 },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "dependencies": { "enum": ["npm", "pnpm"] },
        "env": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 2000 } }
      }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["run"],
      "properties": {
        "description": { "type": "string", "maxLength": 300 },
        "run": {
          "description": "argv; no shell. '{source}' expands to the source repository root (read-only).",
          "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 400 },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "dependencies": { "enum": ["none", "npm", "pnpm"] },
        "unsandboxed": { "description": "Skip the OS sandbox for this check, even in required mode. Governance-controlled opt-out.", "type": "boolean", "default": false },
        "network": { "type": "boolean" },
        "loopback": { "description": "Allow loopback bind and connect on Seatbelt; no-op on bubblewrap.", "type": "boolean", "default": false },
        "browser": { "description": "Allow a headless Chromium to register and look up its own org.chromium.* Mach services on Seatbelt; no-op on bubblewrap. Implies nothing else.", "type": "boolean", "default": false },
        "env": {
          "description": "Fixed environment additions. Values are literal; no host variables are forwarded.",
          "type": "object", "additionalProperties": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  }
}
